#!/usr/bin/env bash

MAX_SIZE=2097152
FAILED=0

while IFS= read -r -d '' FILE; do

  SIZE=$(git cat-file -s ":$FILE" 2>/dev/null) || continue

  if (( SIZE > MAX_SIZE )); then
    echo "ERROR: $FILE is larger than 2 MB"
    FAILED=1
  fi

done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if (( FAILED == 1 )); then
  echo "Commit blocked: Files larger than 2 MB are not allowed."
  exit 1
fi

exit 0
